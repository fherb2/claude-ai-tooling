# Python bytecode caches, created by every test run
__pycache__/
*.py[cod]

*.bundle

# In case a local python venv will be needed, use this:
.venv/

# temporary files
*.tmp.*
*.tmp

# Werkbaenke des Worktree-Arbeitsmodells. Sie liegen bewusst im Repository,
# damit der Editor sie mitbeobachtet; versioniert wird ihr Inhalt ueber ihre
# eigenen Branches, nie ueber den Haupt-Checkout.
/.claude/worktrees/

# Wegwerf-Testkopie des Skills; die gepflegte Fassung liegt in chat-export/skills/
/.claude/skills/chat-export/
/.claude/test_chat_imports/

# Zielordner fuer Skill-Testimporte mit echtem Chat-Inhalt aus dem eigenen
# Konto -- nie versionieren. Anlass: Der Lauf vom 21. August 2026 legte
# .claude/imported_chats/ an, das dafuer noch nicht ausgeschlossen war
# (chat-export/testlauf.md, Abschnitt "27c").
/.claude/test_chat_imports/

# Ablage fuer Untersuchungsmaterial (echte Chatinhalte, Exportdumps): die
# Inhalte werden nie versioniert, der Ordner selbst schon -- er ist der
# verabredete Platz dafuer. Gilt fuer jeden so benannten Ordner, egal wie
# tief verschachtelt.
**/test_results/*
!**/test_results/.gitkeep
**/test_data/*
!**/test_data/.gitkeep
**/test_project
project_source.txt

# rein persönliche Daten, die nie den Rechner verlassen
Fossil-Synology-Konfigurationsanleitung-Herbrand.md
