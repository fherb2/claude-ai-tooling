// Zugangsdaten niemals abgleichen - bewusst OHNE führenden Schraegstrich,
// damit die Datei auf jeder Ebene ausgeschlossen ist
.credentials.json

// Ganze Verzeichnisse samt Inhalt
/cache
/downloads
/telemetry

// Rechnergebundenes: Sitzungsmerker, Umgebung, Shell-Aufnahmen, IDE-Anbindung
// Begruendung je Muster in 3.9 der Doku
/ide
/sessions
/session-env
/shell-snapshots

// Momentaufnahmen vor jeder Bearbeitung, fuer /rewind. Rechnergebunden und
// entbehrlich; ersetzt wird die Funktion durch die Checkpoint-Commits.
// Begruendung und Preis des Ausschlusses in 1.3 der Doku
/file-history

// Fluechtige Dateien
*.log
*.sock

// Synology-Papierkorb, falls im Zielordner aktiviert
#recycle
